---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/experience", label: "Experience" },
  { href: "/skills", label: "Skills" },
  { href: "/projects/homelab", label: "Homelab" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/85 backdrop-blur">
  <div class="navbar mx-auto max-w-7xl px-5 md:px-8">
    <div class="navbar-start">
      <a href="/" class="text-lg font-semibold tracking-tight hover:text-primary"> Faid Rihan </a>
    </div>

    <nav class="navbar-center hidden gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a href={item.href} class="btn btn-ghost btn-sm">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="navbar-end gap-2">
      <ThemeToggle />

      <details class="dropdown dropdown-end lg:hidden">
        <summary class="btn btn-ghost btn-circle" aria-label="Open navigation menu" title="Menu">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 6h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
          </svg>
        </summary>

        <div
          class="dropdown-content z-[1] mt-3 w-56 rounded-2xl border border-base-300 bg-base-100 p-2 shadow-xl"
        >
          <ul class="menu w-full gap-1 p-0">
            {
              navItems.map((item) => (
                <li class="w-full">
                  <a
                    href={item.href}
                    class="flex w-full rounded-xl px-3 py-3 text-base font-medium"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>
