---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
}

const { title, description, tags, href } = Astro.props;
---

<a href={href} class="card bg-base-200 shadow-xl transition hover:-translate-y-1 hover:bg-base-300">
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p class="text-base-content/70">{description}</p>

    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="badge badge-outline">{tag}</span>
      ))}
    </div>
  </div>
</a>