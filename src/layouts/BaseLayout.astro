---
import "../assets/app.css";
import Navbar from "../components/Navbar.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Portfolio of Faid Rihan, M.Sc. Informatics student and software developer based in Munich.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Faid Rihan</title>

    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme) {
        document.documentElement.setAttribute("data-theme", storedTheme);
      }
    </script>
  </head>

  <body class="min-h-screen bg-base-100 text-base-content antialiased">
    <Navbar />

    <main class="mx-auto w-full max-w-7xl px-5 py-8 md:px-8">
      <slot />
    </main>

    <footer
      class="mx-auto max-w-7xl border-t border-base-300 px-5 py-8 text-sm text-base-content/65 md:px-8"
    >
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <p>© {new Date().getFullYear()} Faid Rihan</p>

        <div class="flex flex-wrap gap-x-4 gap-y-2">
          <a href="/impressum" class="hover:text-primary hover:underline">Impressum</a>
          <a href="/privacy" class="hover:text-primary hover:underline">Privacy</a>
          <span class="text-base-content/40">Built with Astro, Tailwind CSS and daisyUI.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
