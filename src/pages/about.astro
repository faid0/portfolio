---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <section class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">About me</p>
    <h1 class="mt-2 text-4xl font-bold">Hi, I'm Faid.</h1>

    <div class="mt-6 space-y-4 text-base-content/70">
      <p>
        I'm an M.Sc. Informatics student at the Technical University of Munich and a software developer
        based in Munich.
      </p>

      <p>
        My interests are at the intersection of backend systems, full-stack development, cloud infrastructure,
        machine learning, autonomous systems, and scientific computing.
      </p>

      <p>
        I enjoy building practical systems, understanding how things work under the hood, and turning technical
        ideas into usable software.
      </p>
    </div>
  </section>
</BaseLayout>