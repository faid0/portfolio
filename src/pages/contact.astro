---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact">
  <section class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">Get in touch</p>
    <h1 class="mt-2 text-4xl font-bold">Contact</h1>

    <p class="mt-4 text-base-content/70">
      I'm based in Munich and open to software engineering, backend, full-stack, machine learning,
      and infrastructure-related opportunities.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="mailto:faid.r03@gmail.com" class="btn btn-primary">Email me</a>
      <a href="https://github.com/faid0" class="btn btn-outline">GitHub</a>
    </div>
  </section>
</BaseLayout>
