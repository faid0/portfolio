---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);

const profileHighlights = [
  {
    label: "Most recent work",
    title: "Software Developer at H&D GmbH",
    body: "Working student role from 09/2024 to 04/2026 with backend features, microservices, APIs, Java, Rust, and cloud-oriented tooling.",
  },
  {
    label: "Academic route",
    title: "M.Sc. Informatics at TUM",
    body: "Master's program started in 04/2026 after completing the B.Sc. Informatics at TUM.",
  },
];

const focusAreas = [
  {
    title: "Backend & APIs",
    body: "Java, Rust, REST, GraphQL, gRPC, microservices, Keycloak and database-backed systems.",
  },
  {
    title: "Infrastructure",
    body: "Docker, Caddy, Proxmox, DNS, HTTPS, firewall rules and self-hosted deployment.",
  },
  {
    title: "ML & Autonomous Systems",
    body: "Deep learning, GNNs, GANs, VAEs, motion planning and scientific computing.",
  },
];
---

<BaseLayout
  title="Portfolio"
  description="Faid Rihan — M.Sc. Informatics student at TUM, software developer, and ML/autonomous systems enthusiast."
>
  <section class="page-section pt-8 md:pt-14">
    <div class="max-w-5xl">
      <p class="section-label">Software developer · M.Sc. Informatics student</p>

      <h1 class="mt-5 max-w-5xl text-4xl font-bold tracking-tight md:text-6xl">
        Software engineering across systems, infrastructure and applied machine learning.
      </h1>

      <p class="muted mt-6 max-w-3xl text-xl leading-9">
        I'm Faid Rihan, an Informatics student at the Technical University of Munich. I build
        backend systems, APIs, full-stack features, self-hosted infrastructure, and ML-oriented
        software projects.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="btn btn-primary">View projects</a>
        <a href="/contact" class="btn btn-outline">Contact</a>
        <a href="https://github.com/faid0" target="_blank" rel="noreferrer" class="btn btn-ghost">
          GitHub
        </a>
        <a
          href="https://de.linkedin.com/in/faid-rihan-24b336254"
          target="_blank"
          rel="noreferrer"
          class="btn btn-ghost"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="mb-8 flex flex-col justify-between gap-3 md:flex-row md:items-end">
      <div>
        <p class="section-label">At a glance</p>
        <h2 class="section-title">Key experience</h2>
      </div>

      <a href="/experience" class="text-base text-primary hover:underline"> Full experience → </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        profileHighlights.map((item) => (
          <div class="surface-card">
            <div class="surface-card-body">
              <p class="text-sm font-medium text-primary">{item.label}</p>
              <h3 class="mt-2 text-xl font-semibold">{item.title}</h3>
              <p class="muted mt-3 text-base leading-7">{item.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="page-section">
    <div class="mb-8 flex flex-col justify-between gap-3 md:flex-row md:items-end">
      <div>
        <p class="section-label">Selected work</p>
        <h2 class="section-title">Featured projects</h2>
      </div>

      <a href="/projects" class="text-base text-primary hover:underline"> All projects → </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="page-section">
    <div class="mb-8">
      <p class="section-label">Core areas</p>
      <h2 class="section-title">What I build</h2>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {
        focusAreas.map((area) => (
          <div class="surface-card">
            <div class="surface-card-body">
              <h3 class="text-xl font-semibold">{area.title}</h3>
              <p class="muted mt-3 text-base leading-7">{area.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
