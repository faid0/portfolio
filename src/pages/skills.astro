---
import BaseLayout from "../layouts/BaseLayout.astro";

const skillGroups = [
  {
    title: "Programming",
    skills: ["Python", "Java", "Rust", "C++", "TypeScript", "JavaScript"],
  },
  {
    title: "Backend & APIs",
    skills: ["REST", "GraphQL", "gRPC", "Microservices", "Keycloak"],
  },
  {
    title: "Databases",
    skills: ["PostgreSQL", "MongoDB", "MariaDB", "Redis", "SQL", "SeaORM"],
  },
  {
    title: "Frontend",
    skills: ["Vue", "HTML", "CSS", "Tailwind CSS", "daisyUI"],
  },
  {
    title: "Cloud & DevOps",
    skills: ["Docker", "Git", "Kubernetes", "AWS", "Caddy", "Proxmox"],
  },
  {
    title: "Machine Learning",
    skills: ["Supervised Learning", "Deep Learning", "GNNs", "GANs", "VAEs"],
  },
];
---

<BaseLayout title="Skills">
  <section class="page-section pt-10">
    <p class="section-label">Technical profile</p>
    <h1 class="section-title">Skills</h1>
  </section>

  <section class="grid gap-5 md:grid-cols-2">
    {
      skillGroups.map((group) => (
        <div class="surface-card">
          <div class="surface-card-body">
            <h2 class="card-title">{group.title}</h2>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="soft-tag">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
